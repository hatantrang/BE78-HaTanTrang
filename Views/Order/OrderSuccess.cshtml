@model _25DH110581_Hà_Tấn_Trạng_MyStore.Models.Order
@{
    ViewBag.Title = "Xác nhận đơn hàng";
}

<div class="alert alert-success">
    <h4 class="alert-heading mb-1">Đặt hàng thành công!</h4>
    Cảm ơn bạn đã mua hàng. Thông tin đơn hàng của bạn như sau.
</div>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header fw-bold">Thông tin đơn hàng</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Mã đơn hàng</dt>
                    <dd class="col-sm-7">#@Model.OrderID</dd>
                    <dt class="col-sm-5">Ngày đặt hàng</dt>
                    <dd class="col-sm-7">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Tổng số tiền</dt>
                    <dd class="col-sm-7 fw-bold text-danger">@string.Format("{0:N0} đ", Model.TotalAmount)</dd>
                    <dt class="col-sm-5">Trạng thái đơn</dt>
                    <dd class="col-sm-7">@Model.OrderStatus</dd>
                    <dt class="col-sm-5">Trạng thái thanh toán</dt>
                    <dd class="col-sm-7">@Model.PaymentStatus</dd>
                    <dt class="col-sm-5">Phương thức thanh toán</dt>
                    <dd class="col-sm-7">@Model.PaymentMethod</dd>
                    <dt class="col-sm-5">Phương thức giao hàng</dt>
                    <dd class="col-sm-7">@Model.DeliveryMethod</dd>
                    <dt class="col-sm-5">Địa chỉ giao hàng</dt>
                    <dd class="col-sm-7">@Model.ShippingAddress</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-header fw-bold">Chi tiết đơn hàng</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Tổng giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.OrderDetails)
                        {
                            <tr>
                                <td>@(d.Product != null ? d.Product.ProductName : "(sản phẩm đã bị xóa)")</td>
                                <td>@d.Quantity</td>
                                <td>@string.Format("{0:N0} đ", d.UnitPrice)</td>
                                <td>@string.Format("{0:N0} đ", d.TotalPrice ?? d.Quantity * d.UnitPrice)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<p class="mt-3">
    @Html.ActionLink("Xem lịch sử mua hàng", "MyOrder", "Order", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("Tiếp tục mua sắm", "Index", "Home", null, new { @class = "btn btn-outline-secondary" })
</p>
