@model _25DH110581_Hà_Tấn_Trạng_MyStore.Models.ViewModel.Cart
@using PagedList.Mvc

@if (Model.SimilarProducts != null && Model.SimilarProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 class="fw-bold mb-3">Sản phẩm tương tự</h4>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var product in Model.SimilarProducts)
            {
                <div class="col">
                    <div class="product-card text-center">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(string.IsNullOrEmpty(product.ProductImage) ? "~/Content/images/default_img.png" : product.ProductImage)" alt="@product.ProductName" />
                        </a>
                        <p class="prodName mt-2 mb-1">@product.ProductName</p>
                        <p class="prodPrice mb-2">@string.Format("{0:N0} đ", product.ProductPrice)</p>
                        @if (product.ProductStock > 0)
                        {
                            <a class="btn btn-sm btn-info text-white"
                               href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID, quantity = 1 })">Thêm vào giỏ</a>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Hết hàng</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="pagination-container mt-3">
            @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", "Cart", new { page }))
        </div>
    </section>
}
