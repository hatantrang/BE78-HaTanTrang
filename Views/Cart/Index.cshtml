@model _25DH110581_Hà_Tấn_Trạng_MyStore.Models.ViewModel.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<link rel="stylesheet" type="text/css" href="~/Content/myStyle/CustomerHome.css" />

<h2 class="mb-3">GIỎ HÀNG</h2>

@if (TempData["CartError"] != null)
{
    <div class="alert alert-warning">@TempData["CartError"]</div>
}

@if (!Model.Items.Any())
{
    <div class="alert alert-info">Giỏ hàng của bạn đang trống.</div>
    <a class="btn btn-secondary" href="@Url.Action("Index", "Home")">Tiếp tục mua hàng</a>
}
else
{
    <div class="row g-4">
        <div class="col-lg-9">
            @using (Html.BeginForm("SelectForCheckout", "Cart", FormMethod.Post, new { id = "frmCart" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input" id="chkAll" checked />
                    <label class="form-check-label" for="chkAll">Chọn tất cả (@Model.Count sản phẩm)</label>
                </div>

                foreach (var group in Model.GroupedItems)
                {
                    <div class="card mb-3">
                        <div class="card-header fw-bold">Danh mục: @group.Key</div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:40px;"></th>
                                        <th>Sản phẩm</th>
                                        <th>Đơn giá</th>
                                        <th style="width:110px;">Số lượng</th>
                                        <th>Thành tiền</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in group)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" name="selectedIds" value="@item.ProductID" class="form-check-input chk-item"
                                                       data-total="@item.TotalPrice.ToString(inv)" checked />
                                            </td>
                                            <td>
                                                <img class="cart-img me-2"
                                                     src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/images/default_img.png" : item.ProductImage)" alt="" />
                                                <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">@item.ProductName</a>
                                                @if (item.Stock <= 0)
                                                {
                                                    <div class="small text-danger">Hết hàng - vui lòng xóa khỏi giỏ</div>
                                                }
                                                else if (item.Quantity > item.Stock)
                                                {
                                                    <div class="small text-danger">Chỉ còn @item.Stock sản phẩm - hãy giảm số lượng</div>
                                                }
                                                else if (item.Stock <= 5)
                                                {
                                                    <div class="small text-warning">Chỉ còn @item.Stock sản phẩm</div>
                                                }
                                            </td>
                                            <td>@string.Format("{0:N0} đ", item.UnitPrice)</td>
                                            <td>
                                                <input type="number" min="1" max="@Math.Max(1, item.Stock)" name="quantity" value="@item.Quantity"
                                                       form="frmQty-@item.ProductID" class="form-control form-control-sm"
                                                       onchange="this.form.submit()" />
                                            </td>
                                            <td class="fw-bold">@string.Format("{0:N0} đ", item.TotalPrice)</td>
                                            <td>
                                                <button type="submit" form="frmRem-@item.ProductID" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }

            
            @foreach (var item in Model.Items)
            {
                using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { id = "frmQty-" + item.ProductID }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.ProductID" />
                }
                using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post, new { id = "frmRem-" + item.ProductID }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.ProductID" />
                }
            }
            @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post, new { id = "frmClear" }))
            {
                @Html.AntiForgeryToken()
            }
        </div>

        <div class="col-lg-3">
            <div class="summary-box">
                <h5 class="mb-3">Tính tiền</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span>Đã chọn:</span><span id="selCount">0</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold">Tạm tính:</span>
                    <span class="fw-bold text-danger fs-5" id="selTotal">0 đ</span>
                </div>
                <button type="submit" form="frmCart" class="btn btn-danger w-100 mb-2">Mua hàng</button>
                <a class="btn btn-outline-secondary w-100 mb-2" href="@Url.Action("Index", "Home")">Tiếp tục mua hàng</a>
                <button type="submit" form="frmClear" class="btn btn-link text-danger w-100"
                        onclick="return confirm('Xóa toàn bộ giỏ hàng?');">Xóa giỏ hàng</button>
            </div>
        </div>
    </div>

    <hr />
    @Html.Partial("_PVSimilarProduct", Model)
}

@section scripts {
    <script>
        (function () {
            var items = document.querySelectorAll('.chk-item');
            var all = document.getElementById('chkAll');
            function recalc() {
                var total = 0, count = 0;
                for (var i = 0; i < items.length; i++) {
                    if (items[i].checked) {
                        total += parseFloat(items[i].getAttribute('data-total')) || 0;
                        count++;
                    }
                }
                var c = document.getElementById('selCount');
                var t = document.getElementById('selTotal');
                if (c) { c.textContent = count; }
                if (t) { t.textContent = Math.round(total).toLocaleString('vi-VN') + ' đ'; }
                if (all) { all.checked = items.length > 0 && count === items.length; }
            }
            for (var i = 0; i < items.length; i++) { items[i].addEventListener('change', recalc); }
            if (all) {
                all.addEventListener('change', function () {
                    for (var i = 0; i < items.length; i++) { items[i].checked = all.checked; }
                    recalc();
                });
            }
            recalc();
        })();
    </script>
}
