@model _25DH110581_Hà_Tấn_Trạng_MyStore.Models.ViewModel.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
}

<div class="auth-card card">
    <div class="card-body">
        <h3 class="card-title mb-3">Đăng nhập</h3>
        @if (TempData["RegisterSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["RegisterSuccess"]</div>
        }

        @using (Html.BeginForm("Login", "Account", new { returnUrl = (string)ViewBag.ReturnUrl }, FormMethod.Post, new { }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username" })
                @Html.ValidationMessageFor(m => m.Username)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <div class="form-check mb-3">
                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
            </div>

            <button type="submit" class="btn btn-info w-100 text-white">Đăng nhập</button>
        }

        <p class="mt-3 mb-0">Bạn chưa có tài khoản? @Html.ActionLink("Đăng ký", "Register", "Account")</p>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
