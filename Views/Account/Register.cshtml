@model _25DH110581_Hà_Tấn_Trạng_MyStore.Models.ViewModel.RegisterVM
@{
    ViewBag.Title = "Đăng ký tài khoản";
}

<div class="auth-card card">
    <div class="card-body">
        <h3 class="card-title mb-3">Đăng ký tài khoản</h3>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Username, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username" })
                @Html.ValidationMessageFor(m => m.Username)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.Password)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.CustomerName, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerName)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control", type = "tel" })
                @Html.ValidationMessageFor(m => m.CustomerPhone)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email" })
                @Html.ValidationMessageFor(m => m.CustomerEmail)
            </div>
            <div class="mb-3">
                @Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label fw-bold" })
                @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.CustomerAddress)
            </div>

            <button type="submit" class="btn btn-info w-100 text-white">Đăng ký</button>
        }

        <p class="mt-3 mb-0">Bạn đã có tài khoản? @Html.ActionLink("Đăng nhập", "Login", "Account")</p>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
